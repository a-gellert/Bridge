-- World controller: steps the session simulation, keeps the 3D views in sync with it, drives the camera,
-- physical sound effects and particles. All visuals are spawned through factories next to this script.
local boot = require("platform.boot")
local poki = require("platform.poki")
local audio = require("platform.audio")
local haptics = require("platform.haptics")
local session = require("game.core.session")
local events = require("game.core.events")
local progress = require("game.core.progress")
local levels = require("game.levels.levels")
local terrain = require("game.physics.terrain")
local Blueprint = require("game.bridge.blueprint")
local tuning = require("game.config.tuning")
local themes = require("game.config.themes")
local camera = require("world.camera")
local level_view = require("world.level_view")
local bridge_view = require("world.bridge_view")
local guide_view = require("world.guide_view")
local tutorial_view = require("world.tutorial_view")
local vehicle_view = require("world.vehicle_view")
local fx = require("world.fx")

local ENGINE = "/sounds#engine"

-- One-shot FTUE funnel event stored in the profile, sent to Poki exactly once.
local function ftue(step)
	if progress.ftue(step) then poki.measure("ftue", step, "1") end
end

local function level_bounds(level)
	local a = level.area or { level.start, -4, level.finish, 6 }
	local x0 = math.min(level.start, a[1]) - 4
	local x1 = math.max(level.finish, a[3]) + 4
	local y0 = math.min(a[2], (level.water or level.kill_y or -8)) - 2
	local y1 = a[4] + 10
	return { x0, y0, x1, y1 }
end

local function fit_build(level, immediate, duration)
	local a = level.area or { level.start, -4, level.finish, 6 }
	local x0, x1 = a[1] - 1.5, a[3] + 1.5
	-- show a bit of both banks so the goal is readable
	local min_w = 14
	if x1 - x0 < min_w then
		local c = (x0 + x1) * 0.5
		x0, x1 = c - min_w * 0.5, c + min_w * 0.5
	end
	camera.bounds = level_bounds(level)
	camera.fit(x0, a[2] - 1, x1, a[4] + 1.5, immediate, duration)
end

-- Decorative scene behind the main menu: the last played level with the player's own bridge
-- (never the reference solution of an unsolved level).
local function show_menu_scene(self)
	local index = math.max(1, math.min(levels.COUNT, progress.get("last_level") or 1))
	local level = levels.get(index)
	self.scene_level = level
	self.geo = terrain.build(level)
	level_view.build(level)
	level_view.set_build_helpers(false)
	local bp = Blueprint.new(level, self.geo)
	local design = progress.design(level.id)
	if not design and index == 1 then design = level.solution end
	bp:load(design or {})
	bridge_view.destroy()
	bridge_view.sync(bp)
	guide_view.clear()
	tutorial_view.clear()
	vehicle_view.destroy()
	fx.clear()
	fit_build(level, true)
	self.menu_t = 0
end

local function on_level_loaded(self)
	local level = session.level
	self.geo = session.geo
	fx.clear()
	vehicle_view.destroy()
	bridge_view.destroy()
	guide_view.clear()
	tutorial_view.clear()
	level_view.build(level)
	level_view.set_build_helpers(true)
	bridge_view.sync(session.blueprint)
	guide_view.sync(session)
	tutorial_view.sync(session)
	vehicle_view.create_preview(level, session.vehicle, session.geo)
	fit_build(level, true)
	-- Level analytics: one start per loaded level. If the previous unresolved level was
	-- skipped (level screen / debug jump), close it as a fail first.
	if self.measure_active then poki.level_end(self.measure_id, false) end
	self.measure_id = level.id
	self.measure_active = true
	poki.level_start(level.id)
	if session.index == 1 then ftue("level1_loaded") end
end

local function stop_engine(self)
	if self.engine_on then
		sound.stop(ENGINE)
		self.engine_on = false
	end
end

local function handle_event(self, e)
	local id, d = e.id, e.data
	if id == "level_loaded" then
		on_level_loaded(self)
	elseif id == "design_changed" or id == "hint" then
		if session.blueprint then bridge_view.sync(session.blueprint) end
		guide_view.sync(session)
		tutorial_view.sync(session)
	elseif id == "vehicle_changed" then
		if session.state == "build" and session.level then
			vehicle_view.create_preview(session.level, session.vehicle, session.geo)
		end
	elseif id == "built" then
		ftue("first_beam_built")
	elseif id == "drive_started" then
		level_view.set_build_helpers(false)
		bridge_view.clear_build_helpers()
		guide_view.clear()
		tutorial_view.clear()
		vehicle_view.create(session.run)
		poki.gameplay_start()
		poki.measure("run", session.level and session.level.id, "start")
		ftue("first_drive_started")
		if audio.is_enabled() then
			sound.play(ENGINE, { gain = 0.35 })
			self.engine_on = true
		end
	elseif id == "drive_stopped" then
		-- Building is gameplay too: never pair this with gameplay_stop / level_end.
		vehicle_view.destroy()
		fx.clear()
		stop_engine(self)
		camera.set_speed_fov(0)
		level_view.set_build_helpers(true)
		bridge_view.sync(session.blueprint)
		guide_view.sync(session)
		tutorial_view.sync(session)
		if session.level then vehicle_view.create_preview(session.level, session.vehicle, session.geo) end
		fit_build(session.level, false, 0.2)
	elseif id == "result" then
		-- Win cards and the "stuck?" assist card are a deliberate pause; the fast fail path
		-- goes straight back to building, so it must not stop the play session.
		if d.won or d.can_assist then poki.gameplay_stop() end
		if not d.won then
			camera.set_speed_fov(0)
			fit_build(session.level, false, 0.2)
		end
	elseif id == "beam_broken" then
		fx.beam_break(d.x, d.y, d.mat)
		local snd = (d.mat == "rope" or d.mat == "cable") and "snap" or ((d.mat == "steel" or d.mat == "steel_road") and "break_steel" or "break_wood")
		audio.play(snd, 0.8, 0.9 + math.random() * 0.25)
		haptics.break_beam()
		camera.shake(0.18, 0.25)
	elseif id == "achievement" then
		audio.play("achievement", 0.75)
		haptics.vibrate("[20,40,20]", 0.25)
	elseif id == "portal" then
		if d.entry_x then level_view.flash_portal(d.entry_x, d.entry_y) end
		level_view.flash_portal(d.x, d.y)
		if d.entry_x then fx.portal_burst(d.entry_x, d.entry_y, { 0.35, 0.65, 1 }) end
		fx.portal_burst(d.x, d.y, { 1, 0.6, 0.2 })
		audio.play("portal", 0.8)
		haptics.portal()
		camera.shake(0.08, 0.15)
		camera.drama(0.6, 0.3)
	elseif id == "land" then
		local p = d.power or 0.3
		fx.dust(d.x, d.y, themes.get(session.level.theme).ground)
		if p > 0.25 then
			camera.shake(0.05 + p * 0.12, 0.1 + p * 0.12)
			if p > 0.5 then haptics.vibrate(20, 0.1) end
		end
	elseif id == "bounce" then
		audio.play("bounce", 0.8)
		haptics.bounce()
		camera.drama(0.7, 0.32)
		if session.run then
			local cx, cy = session.run.vehicle:center()
			fx.dust(cx, cy - 0.7, { 0.5, 0.75, 1 })
		end
	elseif id == "boost" then
		audio.play("boost", 0.6)
		haptics.boost()
		camera.drama(0.9, 0.3)
		if session.run then
			local cx, cy = session.run.vehicle:center()
			fx.sparks(cx - 0.6, cy - 0.3, { 1, 0.62, 0.2 })
		end
	elseif id == "stunt" then
		if d.kind == "flip" and session.run then
			local cx, cy = session.run.vehicle:center()
			fx.sparks(cx, cy, { 1, 0.82, 0.25 })
			audio.play("star", 0.45, 1.25)
			haptics.click()
			camera.shake(0.06, 0.12)
		elseif d.combo == 3 or d.combo == 5 then
			audio.play("star", 0.5, 1.15)
			camera.drama(0.5, 0.22)
			haptics.click()
			if session.run then
				local cx, cy = session.run.vehicle:center()
				fx.sparks(cx, cy, { 1, 0.85, 0.25 })
			end
		end
	elseif id == "slowmo" then
		camera.drama(1.0, 0.55)
	elseif id == "run_finished" then
		stop_engine(self)
		camera.set_speed_fov(0)
		poki.measure("run", session.level and session.level.id, d.won and "win" or tostring(d.reason))
		if d.won and self.measure_active then
			poki.level_end(self.measure_id, true)
			self.measure_active = false
		end
		if d.won then
			local lvl = session.level
			if lvl and lvl.chapter_index == 1 then
				local n = lvl.number
				if n == 1 or n == 2 or n == 3 or n == 5 or n == 8 then ftue("level" .. n .. "_won") end
			end
			haptics.win()
		else
			haptics.crash()
		end
		if session.run then
			local cx, cy = session.run.vehicle:center()
			if d.won then
				fx.confetti(cx, cy)
				audio.play("horn", 0.7, 0.9)
			elseif d.reason == "fell" and session.level.water then
				fx.splash(cx, session.level.water, themes.get(session.level.theme).water)
				audio.play("splash", 0.9)
			else
				fx.crash(cx, cy)
				audio.play("crash", 0.9)
				camera.shake(0.35, 0.4)
				camera.drama(0.8, 0.45)
			end
		end
	elseif id == "state" then
		if d.state == "menu" then
			stop_engine(self)
			if self.measure_active then
				poki.level_end(self.measure_id, false)
				self.measure_active = false
			end
			poki.gameplay_stop()
			show_menu_scene(self)
		end
	end
end

function init(self)
	boot.init()
	events.subscribe("world")
	self.engine_on = false
	self.measure_active = false
	self.measure_id = nil
	self.perf_t, self.perf_n = 0, 0
	camera.set_window(window.get_size())
	-- the GUI may have started a level before this script subscribed to events
	if session.state == "menu" then
		show_menu_scene(self)
	elseif session.level then
		on_level_loaded(self)
	end
end

function final(self)
	events.unsubscribe("world")
	stop_engine(self)
end

function update(self, dt)
	dt = math.min(dt, 0.1)
	if not poki.is_ad_active() then
		session.update(dt)
	end
	local evs = events.drain("world")
	if evs then
		for _, e in ipairs(evs) do handle_event(self, e) end
	end

	camera.set_window(window.get_size())
	-- adaptive quality: drop the particle budget if frames are consistently slow
	self.perf_t = (self.perf_t or 0) + dt
	if self.perf_t > 2.5 then
		if self.perf_t / (self.perf_n or 1) > 0.026 then
			fx.set_budget(120)
		else
			fx.set_budget(240)
		end
		self.perf_t, self.perf_n = 0, 0
	end
	self.perf_n = (self.perf_n or 0) + 1
	local state = session.state
	if state == "build" then
		camera.set_speed_fov(0)
		bridge_view.update_build(dt, session)
		guide_view.update(dt)
		tutorial_view.update(dt, session)
	elseif (state == "drive" or state == "result") and session.run then
		local run = session.run
		bridge_view.update_drive(dt, run)
		vehicle_view.update(run, self.geo)
		local cx, cy = run.vehicle:center()
		local vx, vy = run.vehicle:velocity()
		local spd = run.vehicle:speed()
		camera.bounds = nil
		if state == "drive" or (session.result and session.result.won) then
			camera.follow(cx, cy, tuning.CAM_DRIVE_SPAN, math.max(-2, math.min(4, vx * 0.35)))
			camera.set_speed_fov(math.min(1, spd / tuning.CAM_DRIVE_SPAN))
		end
		-- structural creak: the player hears the bridge giving up before it snaps
		local stress = run:stress()
		if stress > 0.75 then
			local k = math.min(1, (stress - 0.75) / 0.25)
			audio.play("creak", 0.32 + 0.5 * k, 0.82 + 0.38 * k)
		end
		-- tire squeal when the wheels slide
		local slip = run:slip()
		if slip > 2.4 and spd > 3 then
			audio.play("skid", 0.2 + math.min(0.35, slip * 0.05), 0.9 + math.min(0.25, slip * 0.03))
			if slip > 5 and math.random() < 0.35 then
				fx.smoke(cx, cy - 0.4, 0, { 0.45, 0.44, 0.42 }, 1)
			end
		end
		if self.engine_on then
			local gas = session.input.gas and 0.24 or 0
			go.set(ENGINE, "speed", 0.66 + math.min(1.25, spd / 9) + gas + (stress > 0.82 and 0.08 or 0))
		end
	elseif state == "menu" and self.scene_level then
		camera.set_speed_fov(0)
		self.menu_t = (self.menu_t or 0) + dt
		local a = self.scene_level.area or { 0, 0, 10, 5 }
		local cx = (a[1] + a[3]) * 0.5 + math.sin(self.menu_t * 0.15) * 3
		camera.tx = cx
	end
	level_view.update(dt)
	fx.update(dt)
	camera.update(dt)
	msg.post("@render:", "set_world_camera", { view = camera.view, proj = camera.proj })
end
