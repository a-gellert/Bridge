-- GUI controller: screens (menu / levels / build / drive + result popup), input routing, resize, toasts.
-- Input order: keyboard shortcuts -> HUD (Druid) -> world (build gestures / drive pedals).

-- gui.pick_node scales the input point by (window / display size) even with ADJUST_REFERENCE_DISABLED,
-- while our nodes live in the virtual canvas. Wrap it so every hit test (Druid included) takes virtual
-- coordinates. Must run before Druid is required (druid.helper caches gui.pick_node).
local PICK = { kx = 1, ky = 1 }
local raw_pick_node = gui.pick_node
gui.pick_node = function(node, x, y)
	return raw_pick_node(node, x * PICK.kx, y * PICK.ky)
end

local ui = require("gui.ui")
local layout = require("gui.layout")
local boot = require("platform.boot")
local poki = require("platform.poki")
local ads = require("platform.ads")
local device = require("platform.device")
local haptics = require("platform.haptics")
local session = require("game.core.session")
local events = require("game.core.events")
local progress = require("game.core.progress")
local achievements = require("game.core.achievements")
local levels = require("game.levels.levels")
local i18n = require("game.core.i18n")
local build_input = require("world.build_input")

local SCREENS = {
	menu = require("gui.screens.menu"),
	levels = require("gui.screens.levels"),
	garage = require("gui.screens.garage"),
	achievements = require("gui.screens.achievements"),
	build = require("gui.screens.build"),
	drive = require("gui.screens.drive"),
}
local result_popup = require("gui.screens.result")

local TOUCH = hash("touch")
local TOUCH_MULTI = hash("touch_multi")

local KEYS = { "gas", "brake", "go", "back", "reset", "erase", "undo", "zoom_in", "zoom_out" }
for i = 1, 8 do KEYS[#KEYS + 1] = "mat_" .. i end

local app = { screen = "menu", tip_shown = {}, gen = 0, key_names = {} }
for _, k in ipairs(KEYS) do app.key_names[hash(k)] = k end

local toast_node, toast_t = nil, 0
local toast_queue = {}
local next_toast

-- ------------------------------------------------------------------ screens
local function screen_for_state()
	local s = session.state
	if s == "build" then return "build" end
	if s == "drive" or s == "result" then return "drive" end
	if app.screen == "levels" or app.screen == "garage" or app.screen == "achievements" then
		return app.screen
	end
	return "menu"
end

function app.rebuild()
	app.gen = app.gen + 1
	for _, s in pairs(SCREENS) do
		if s.clear then s.clear() end
	end
	ui.final()
	if app.root then gui.delete_node(app.root) end
	toast_node = nil
	app.pause_layer = nil
	app.exit_layer = nil
	app.root = ui.pane(nil, 0, 0)
	ui.new_druid()
	app.screen = screen_for_state()
	SCREENS[app.screen].build(app, app.root)
	if session.state == "result" and session.result then
		result_popup.build(app, app.root, session.result)
	end
	if app.paused then app.build_pause_overlay() end
	if app.toast_next then
		local t = app.toast_next
		app.toast_next = nil
		app.toast(t.text, t.color)
	end
	next_toast()
end

function app.show(screen)
	app.screen = screen
	if session.state ~= "menu" then
		session.exit_to_menu() -- emits "state" -> rebuild
	else
		app.rebuild()
	end
end

function app.start_level(index)
	if not progress.level_unlocked(index) then return end
	session.load_level(index)
end

function app.next_level()
	local nxt = (session.index or 0) + 1
	if not levels.get(nxt) then
		app.show("levels")
		return
	end
	ads.interstitial("next_" .. tostring(nxt), function()
		session.load_level(nxt)
	end)
end

-- Pause overlay: blocks the world while the browser tab is hidden, and requires one
-- deliberate tap before play resumes (Poki lifecycle requirement).
function app.build_pause_overlay()
	if not app.root or app.pause_layer then return end
	local vw, vh = app.vw, app.vh
	local dim = ui.box(app.root, "white", vw / 2, vh / 2, vw, vh, ui.hex("#0B0E16", 0.72))
	ui.blocker(dim)
	local panel = ui.panel(dim, 0, 0, math.min(520, vw - 60), 190, ui.PANEL, 28)
	ui.blocker(panel)
	ui.text(panel, i18n.t("paused"), 0, 32, 44, ui.YELLOW)
	ui.label(panel, i18n.t("tap_resume"), 0, -40, 26, ui.WHITE, 440)
	app.pause_layer = dim
	ui.fade_in(dim, 0.18)
end

function app.clear_pause_overlay()
	if app.pause_layer then
		ui.delete(app.pause_layer)
		app.pause_layer = nil
	end
end

-- Android hardware Back on the main menu: ask before closing the app.
function app.confirm_exit()
	if app.exit_layer or not app.root then return end
	local vw, vh = app.vw, app.vh
	local dim = ui.box(app.root, "white", vw / 2, vh / 2, vw, vh, ui.hex("#0B0E16", 0.65))
	ui.blocker(dim)
	local panel = ui.panel(dim, 0, 0, math.min(560, vw - 60), 220, ui.PANEL, 28)
	ui.blocker(panel)
	ui.text(panel, i18n.t("exit_title"), 0, 52, 34, ui.WHITE)
	local bw = (math.min(560, vw - 60) - 50) / 2
	ui.btn(panel, -bw / 2 - 8, -46, bw, 78, i18n.t("exit_yes"), function()
		if sys and sys.exit then pcall(sys.exit, 0) end
	end, { color = ui.PANEL_LT, icon = "close", icon_size = 34, size = 28 })
	ui.btn(panel, bw / 2 + 8, -46, bw, 78, i18n.t("exit_no"), function()
		ui.delete(dim)
		app.exit_layer = nil
	end, { color = ui.GREEN, icon = "back", icon_size = 34, size = 28 })
	app.exit_layer = dim
end

function app.set_paused(on)
	if on == app.paused then return end
	app.paused = on and true or false
	if on then
		session.set_paused(true)
		if session.state == "build" or session.state == "drive" then poki.gameplay_stop() end
		app.build_pause_overlay()
	else
		app.clear_pause_overlay()
		session.set_paused(false)
		if session.state == "build" or session.state == "drive" then poki.gameplay_start() end
	end
end

function app.toast(text, color)
	if not app.root then return end
	-- never replace a visible toast: queue it so rapid achievement unlocks are all readable
	if toast_node then
		toast_queue[#toast_queue + 1] = { text = text, color = color }
		return
	end
	local w = math.min(660, app.vw - 40)
	local y = app.vh * (app.portrait and 0.62 or 0.66)
	local delay = 0
	if session.state == "result" then
		-- the result card owns the middle of the screen: toast near the top, and only after the
		-- title and the stars have landed, so the win moment is never covered
		local _, _, mt = layout.margins(app.vw, app.vh, 16)
		y = app.vh - mt - 118
		delay = 1.2
	end
	toast_node = ui.panel(app.root, app.vw / 2, y, w, 64, ui.hex("#151926", 0.9), 24)
	ui.label(toast_node, text, 0, 2, 28, color or ui.WHITE, w - 30)
	ui.pop(toast_node, delay)
	toast_t = 1.8 + delay
end

next_toast = function()
	if toast_node or #toast_queue == 0 then return end
	local t = table.remove(toast_queue, 1)
	app.toast(t.text, t.color)
end

-- ------------------------------------------------------------------ size
local function update_size()
	local w, h = window.get_size()
	local changed = w ~= app.win_w or h ~= app.win_h
	if changed then
		app.win_w, app.win_h = w, h
		app.vw, app.vh, app.portrait = layout.virtual_size(w, h)
		device.safe_insets(true)
		layout.set_safe_insets(device.safe_insets())
		if w > 0 and h > 0 then
			PICK.kx, PICK.ky = app.dw / w, app.dh / h
			app.px_scale = h / app.vh
			build_input.px_scale = app.px_scale
			build_input.touch = app.touch
		end
	end
	return changed
end

-- ------------------------------------------------------------------ lifecycle
function init(self)
	msg.post(".", "acquire_input_focus")
	boot.init()
	ui.init(self)
	events.subscribe("gui")
	app.dw = sys.get_config_int("display.width", 1280)
	app.dh = sys.get_config_int("display.height", 720)
	app.touch = boot.is_touch()
	haptics.set_enabled(progress.get("haptics") ~= false)
	update_size()
	-- Keep ads/pause honest when the tab loses focus (Poki lifecycle requirement).
	if window.set_listener then
		pcall(window.set_listener, function(_, event)
			if event == window.WINDOW_EVENT_FOCUS_LOST or event == window.WINDOW_EVENT_ICONIFIED then
				app.focus_lost = true
			elseif event == window.WINDOW_EVENT_FOCUS_GAINED or event == window.WINDOW_EVENT_DEICONIFIED then
				app.focus_gained = true
			end
		end)
	end
	-- Poki "first seconds": a brand-new player starts building right away
	if progress.total_stars() == 0 and not progress.get("tutorial_done") then
		session.load_level(1)
		events.drain("gui")
	end
	app.rebuild()
end

function final(self)
	ui.final()
	events.unsubscribe("gui")
end

function update(self, dt)
	if update_size() then app.resize_t = 0.12 end
	if app.resize_t then
		app.resize_t = app.resize_t - dt
		if app.resize_t <= 0 then
			app.resize_t = nil
			app.rebuild()
		end
	end
	-- focus events arrive outside the normal update: handle them here, once
	if app.focus_lost then
		app.focus_lost = nil
		if not poki.is_ad_active() and (session.state == "drive" or session.state == "result") then
			app.set_paused(true)
		end
	end
	if app.focus_gained then
		app.focus_gained = nil
		-- stay paused until the player taps: returning to a live run must be deliberate
	end
	local evs = events.drain("gui")
	if evs then
		local need_rebuild = false
		local will_rebuild = false
		for _, e in ipairs(evs) do
			if e.id == "result" and e.data == session.result and not e.data.won and not e.data.can_assist then
				-- Fast edit after collapse: instant return to build mode (0.1s delay, 0.2s camera return)
				session.stop_drive()
				app.toast(i18n.t("reason_" .. tostring(e.data.reason)), ui.RED)
				need_rebuild = true
			elseif e.id == "state" or e.id == "level_loaded" then
				will_rebuild = true
			end
		end
		for _, e in ipairs(evs) do
			if e.id == "state" or e.id == "level_loaded" then
				need_rebuild = true
			elseif not need_rebuild then
				if e.id == "achievement" then
					local a = achievements.by_id[e.data.id]
					if a then
						local text = i18n.f("ach_toast", i18n.t("ach_" .. a.id))
						if will_rebuild then
							app.toast_next = { text = text, color = ui.YELLOW }
						else
							app.toast(text, ui.YELLOW)
						end
					end
				end
				local scr = SCREENS[app.screen]
				if scr.on_event then scr.on_event(app, e) end
			end
		end
		if need_rebuild then
			build_input.reset()
			app.rebuild()
		end
	end
	if poki.is_ad_active() then return end
	if app.paused then
		if ui.druid then ui.druid:update(dt) end
		return
	end
	local scr = SCREENS[app.screen]
	if scr.update then scr.update(app, dt) end
	if ui.druid then ui.druid:update(dt) end
	if toast_node then
		toast_t = toast_t - dt
		if toast_t <= 0 then
			local n = toast_node
			toast_node = nil
			gui.animate(n, "color.w", 0, gui.EASING_OUTQUAD, 0.3, 0, function() gui.delete_node(n) end)
			next_toast()
		end
	end
end

-- Screen pixels -> virtual canvas units for Druid hit tests (screen_x/screen_y stay raw for the world).
local function to_virtual(action)
	local kx, ky = app.vw / app.dw, app.vh / app.dh
	if action.x then
		action.x, action.y = action.x * kx, action.y * ky
		if action.dx then action.dx, action.dy = action.dx * kx, action.dy * ky end
	end
	if action.touch then
		for i = 1, #action.touch do
			local t = action.touch[i]
			if t.x then t.x, t.y = t.x * kx, t.y * ky end
			if t.dx then t.dx, t.dy = t.dx * kx, t.dy * ky end
		end
		if not action.x and action.touch[1] then
			action.x, action.y = action.touch[1].x, action.touch[1].y
			action.screen_x, action.screen_y = action.touch[1].screen_x, action.touch[1].screen_y
		end
	end
end

function on_input(self, action_id, action)
	if poki.is_ad_active() then return true end
	-- Poki lifecycle: gameplay starts on the player's first deliberate input in a level, not on
	-- level load and not only on ПУСК — building is gameplay too. gameplay_start() is idempotent,
	-- so further taps do not emit extra SDK calls.
	if action.pressed and (session.state == "build" or session.state == "drive") then
		poki.gameplay_start()
	end
	-- the pause overlay takes exactly one deliberate input
	if app.paused then
		if action.pressed then app.set_paused(false) end
		return true
	end
	to_virtual(action)
	if app.screen == "build" and action.pressed and session.state == "build" then app.tutorial_touched = true end
	local scr = SCREENS[app.screen]

	-- keyboard
	if action_id and app.key_names[action_id] then
		if session.state == "result" and session.result then
			return result_popup.on_key(app, action_id, action, session.result)
		end
		if scr.on_key then return scr.on_key(app, action_id, action) end
		return false
	end

	-- a beam drag / pan that started in the world keeps the pointer until release
	if app.screen == "build" and build_input.busy() then
		build_input.on_input(action_id, action)
		return true
	end

	local consumed = ui.druid and ui.druid:on_input(action_id, action) or false
	if consumed then return true end

	if app.screen == "build" and session.state == "build" then
		return build_input.on_input(action_id, action)
	elseif app.screen == "drive" and session.state == "drive" then
		if action_id == TOUCH or action_id == TOUCH_MULTI then
			return SCREENS.drive.on_input(app, action_id, action)
		end
	end
	return false
end
