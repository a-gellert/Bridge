-- World pass (perspective camera from world/camera.lua via "set_camera") + translucent pass + GUI pass.
-- The GUI lives in a virtual canvas (gui/layout.lua) stretched over the whole window.
local layout = require("gui.layout")

local MSG_SET_CAMERA = hash("set_camera")
local MSG_CLEAR_COLOR = hash("clear_color")
local IDENTITY = vmath.matrix4()

function init(self)
	self.pred_model = render.predicate({ "model" })
	self.pred_alpha = render.predicate({ "model_alpha" })
	self.pred_gui = render.predicate({ "gui" })
	self.pred_text = render.predicate({ "debug_text" })
	self.clear = {
		[graphics.BUFFER_TYPE_COLOR0_BIT] = vmath.vector4(0.56, 0.82, 1, 1),
		[graphics.BUFFER_TYPE_DEPTH_BIT] = 1,
		[graphics.BUFFER_TYPE_STENCIL_BIT] = 0,
	}
	self.view = vmath.matrix4_look_at(vmath.vector3(0, 3, 30), vmath.vector3(0, 0, 0), vmath.vector3(0, 1, 0))
	self.proj = vmath.matrix4_perspective(0.6, 16 / 9, 0.5, 300)
end

function update(self)
	local w, h = render.get_window_width(), render.get_window_height()
	if w <= 0 or h <= 0 then return end
	render.set_depth_mask(true)
	render.set_stencil_mask(0xff)
	render.clear(self.clear)
	render.set_viewport(0, 0, w, h)

	-- 3D world
	render.set_view(self.view)
	render.set_projection(self.proj)
	local frustum = self.proj * self.view
	render.enable_state(graphics.STATE_DEPTH_TEST)
	render.enable_state(graphics.STATE_CULL_FACE)
	render.disable_state(graphics.STATE_BLEND)
	render.draw(self.pred_model, { frustum = frustum })

	-- translucent: water, build grid, shadows, portal glow
	render.set_depth_mask(false)
	render.enable_state(graphics.STATE_BLEND)
	render.set_blend_func(graphics.BLEND_FACTOR_SRC_ALPHA, graphics.BLEND_FACTOR_ONE_MINUS_SRC_ALPHA)
	render.draw(self.pred_alpha, { frustum = frustum })
	render.disable_state(graphics.STATE_DEPTH_TEST)
	render.disable_state(graphics.STATE_CULL_FACE)

	-- GUI in virtual units
	local vw, vh = layout.virtual_size(w, h)
	local proj = vmath.matrix4_orthographic(0, vw, 0, vh, -1, 1)
	render.set_view(IDENTITY)
	render.set_projection(proj)
	render.enable_state(graphics.STATE_STENCIL_TEST)
	render.draw(self.pred_gui, { frustum = proj })
	render.draw(self.pred_text, { frustum = proj })
	render.disable_state(graphics.STATE_STENCIL_TEST)
	render.disable_state(graphics.STATE_BLEND)
end

function on_message(self, message_id, message)
	if message_id == MSG_SET_CAMERA then
		self.view = message.view
		self.proj = message.proj
	elseif message_id == MSG_CLEAR_COLOR then
		self.clear[graphics.BUFFER_TYPE_COLOR0_BIT] = message.color
	end
end
