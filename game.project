[bootstrap]
main_collection = /main/main.collectionc
render = /render/bridge.renderc

[script]
shared_state = 1

[display]
width = 1280
height = 720
high_dpi = 1
dynamic_orientation = 1

[render]
clear_color_red = 0.56
clear_color_green = 0.82
clear_color_blue = 1.0
clear_color_alpha = 1.0

[graphics]
default_texture_min_filter = linear
default_texture_mag_filter = linear

[input]
game_binding = /input/game.input_bindingc

[collection]
max_instances = 2048

[model]
max_count = 1536

[factory]
max_count = 128

[sound]
max_component_count = 32

[gui]
max_count = 16

[android]
input_method = HiddenInputField
immersive_mode = 1
display_cutout = 1
package = com.madgames.bridgemad
version_code = 1
minimum_sdk_version = 21
target_sdk_version = 34
app_icon_36x36 = /assets/icons/icon_36.png
app_icon_48x48 = /assets/icons/icon_48.png
app_icon_72x72 = /assets/icons/icon_72.png
app_icon_96x96 = /assets/icons/icon_96.png
app_icon_144x144 = /assets/icons/icon_144.png
app_icon_192x192 = /assets/icons/icon_192.png

[ios]
bundle_identifier = com.madgames.bridgemad
app_icon_76x76 = /assets/icons/icon_76.png
app_icon_120x120 = /assets/icons/icon_120.png
app_icon_152x152 = /assets/icons/icon_152.png
app_icon_167x167 = /assets/icons/icon_167.png
app_icon_180x180 = /assets/icons/icon_180.png

[html5]
htmlfile = /template/poki_template.html
scale_mode = stretch
wasm_streaming = 1
show_fullscreen_button = 0
show_made_with_defold = 0
max_pixel_ratio = 1.5
heap_size = 128

[native_extension]
app_manifest = /main/game.appmanifest

[druid]
input_key_back = back
input_touch = touch
input_multitouch = touch_multi
no_auto_input = 1

[project]
title = Bridge Mad
version = 1.0.0
dependencies#0 = https://github.com/defold/extension-poki-sdk/archive/3e0c3296e6c4a27b99387d9c54d06626daa94b89.zip
dependencies#1 = https://github.com/Insality/defold-event/archive/refs/tags/21.zip
dependencies#2 = https://github.com/Insality/druid/archive/refs/tags/1.3.0.zip
